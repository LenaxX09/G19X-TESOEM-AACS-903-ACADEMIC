<?xml version="1.0" encoding="utf-8"?>
<!-- Sprint 8 (RF-P1..P3): cuentas por pagar del cliente — pestañas
     por pagar/pagadas, chips de clasificación en Pagadas y lista. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pantalla"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_encabezado"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulo_pagos"
            android:textColor="@color/blanco"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/subtitulo_pagos"
            android:textColor="@color/blanco_90"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Pestañas: ⏳ por pagar / ✅ pagadas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnTabPorPagar"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_boton_pill"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTabPagadas"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_boton_pill"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Chips de clasificación (solo en la pestaña Pagadas, RF-P3) -->
    <LinearLayout
        android:id="@+id/filaChipsPagos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/btnChipTodas"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_boton_pill"
            android:text="@string/chip_todas"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnChipAprobadas"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_boton_pill"
            android:text="@string/chip_aprobadas"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnChipNoCoinciden"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_boton_pill"
            android:text="@string/chip_no_coinciden"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnChipDiscrepancias"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_boton_pill"
            android:text="@string/chip_discrepancias"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtEstadoPagos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:textColor="@color/texto_normal"
        android:textSize="13sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recPagos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp" />

    <Button
        android:id="@+id/btnVolverPagos"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_boton_pill"
        android:text="@string/btn_salir_proveedor"
        android:textColor="@color/celeste"
        android:textStyle="bold" />
</LinearLayout>
