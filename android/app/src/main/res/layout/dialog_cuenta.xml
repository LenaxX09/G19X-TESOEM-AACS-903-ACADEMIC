<?xml version="1.0" encoding="utf-8"?>
<!-- Sprint 10: el PROVEEDOR sube la cuenta que el cliente le debe. Con eso
     el cliente ve «lo que debe» en Cuentas por pagar, sin servidor: se
     guarda en Firestore y el oyente del cliente se entera al instante. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <EditText
            android:id="@+id/edtCuentaCliente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/cuenta_cliente_hint"
            android:inputType="textEmailAddress"
            android:maxLines="1" />

        <EditText
            android:id="@+id/edtCuentaCodigo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/cuenta_codigo_hint"
            android:inputType="text"
            android:maxLines="1" />

        <EditText
            android:id="@+id/edtCuentaMonto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/cuenta_monto_hint"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <EditText
            android:id="@+id/edtCuentaLimite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/cuenta_limite_hint"
            android:inputType="date"
            android:maxLines="1" />
    </LinearLayout>
</ScrollView>
