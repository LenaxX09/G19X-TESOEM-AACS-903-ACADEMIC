<?xml version="1.0" encoding="utf-8"?>
<!-- Sprint 7 (RF-F5): registro público de proveedor — usuario, contraseña y
     el nombre de su negocio (con ese nombre calzan sus órdenes de compra). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <EditText
            android:id="@+id/edtRegUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/reg_usuario_hint"
            android:inputType="text"
            android:maxLines="1" />

        <EditText
            android:id="@+id/edtRegPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/reg_password_hint"
            android:inputType="textPassword"
            android:maxLines="1" />

        <EditText
            android:id="@+id/edtRegNegocio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/reg_negocio_hint"
            android:inputType="text"
            android:maxLines="1" />
    </LinearLayout>
</ScrollView>
