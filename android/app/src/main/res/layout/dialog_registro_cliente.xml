<?xml version="1.0" encoding="utf-8"?>
<!-- S10.3: registro de CLIENTE — una sola cuenta (un correo) por empresa:
     con ella entra todo el personal de esa empresa, tiene TODAS las
     funciones (capturar, revisar, pagar) y NO se crean más usuarios. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <EditText
            android:id="@+id/edtCliCorreo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/reg_correo_hint"
            android:inputType="textEmailAddress"
            android:maxLines="1" />

        <EditText
            android:id="@+id/edtCliClave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/reg_password_hint"
            android:inputType="textPassword"
            android:maxLines="1" />

        <EditText
            android:id="@+id/edtCliEmpresa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/reg_cli_empresa_hint"
            android:inputType="text"
            android:maxLines="1" />
    </LinearLayout>
</ScrollView>
