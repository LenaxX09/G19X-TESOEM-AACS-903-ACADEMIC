<?xml version="1.0" encoding="utf-8"?>
<!-- Sprint 10: sin servidor — el spinner de cuentas lo llena Firestore
     (órdenes que el PROVEEDOR subió para este cliente). Ya no hay campo IP. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fondo_pantalla"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Encabezado (0.7.1-ui): banner compacto — título 20sp y aire
             antes del subtítulo para que no se sienta "encimado" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_encabezado"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/titulo"
                android:textColor="@color/blanco"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSubtitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/subtitulo"
                android:textColor="@color/blanco_90"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Sprint 5: quién está conectado (RF-M1). 0.8.1-night: usa texto_normal
             (se aclara de noche) porque va SOBRE el fondo de pantalla, no en tarjeta. -->
        <TextView
            android:id="@+id/txtSesion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:textColor="@color/texto_normal"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Órdenes de compra (GET /api/ordenes.php) en tarjeta suave -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_tarjeta_blanca"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_orden"
                android:textColor="@color/primario"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spOrdenes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Vista previa (RF-M2) con marcador de posición punteado (0.6.0-ui) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/imgPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/fondo_preview"
                android:contentDescription="@string/desc_preview"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/txtPreviewHint"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_placeholder_preview"
                android:gravity="center"
                android:padding="16dp"
                android:text="@string/hint_preview"
                android:textColor="@color/hint_sobre_tarjeta"
                android:textSize="14sp" />
        </FrameLayout>

        <!-- Captura (RF-M2 / RF-M3): cámara y galería lado a lado (0.6.0-ui) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFoto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_boton_secundario"
                android:text="@string/btn_foto"
                android:textColor="@color/primario" />

            <Button
                android:id="@+id/btnGaleria"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_boton_secundario"
                android:text="@string/btn_galeria"
                android:textColor="@color/primario" />
        </LinearLayout>

        <!-- Acción principal de la pantalla (0.6.0-ui: botón de acento) -->
        <Button
            android:id="@+id/btnEnviar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_boton_principal"
            android:enabled="false"
            android:text="@string/btn_enviar"
            android:textColor="@color/texto_boton_principal"
            android:textStyle="bold" />

        <!-- Sprint 4: listado con badges (RF-M5) — píldora azul pastel -->
        <Button
            android:id="@+id/btnLista"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_boton_pill"
            android:text="@string/btn_lista"
            android:textColor="@color/primario"
            android:textStyle="bold" />

        <!-- Sprint 8 (RF-P1): apartado de pagos del CLIENTE (oculto al proveedor) -->
        <Button
            android:id="@+id/btnPagos"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_boton_pill"
            android:text="@string/btn_pagos"
            android:textColor="@color/verde_ok"
            android:textStyle="bold" />

        <!-- Sprint 5: administración (solo admin, se oculta por código) y salir -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAdmin"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_boton_pill"
                android:text="@string/btn_admin"
                android:textColor="@color/primario" />

            <Button
                android:id="@+id/btnSalir"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_boton_pill"
                android:text="@string/btn_salir"
                android:textColor="@color/rojo_error" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/barraEnvio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:indeterminateTint="@color/acento"
            android:visibility="gone" />

        <!-- Panel del veredicto: fondo pastel por estado (lo fija Java) -->
        <TextView
            android:id="@+id/txtResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_veredicto"
            android:padding="14dp"
            android:textColor="@color/texto_normal"
            android:textIsSelectable="true"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
