<?xml version="1.0" encoding="utf-8"?>
<!-- S10.5: pantalla de BLOQUEO — pide la HUELLA del teléfono (o su PIN de
     bloqueo si no tiene lector) con BiometricPrompt del sistema. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fondo_pantalla"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Banner con el estilo de las demás pantallas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_encabezado"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/candado_titulo"
                android:textColor="@color/blanco"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/candado_sub"
                android:textColor="@color/blanco_90"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Tarjeta con la cuenta protegida -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tarjeta_blanca"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtCandadoCorreo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/texto_sobre_tarjeta"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/candado_biometrico_sub"
                android:textColor="@color/hint_sobre_tarjeta"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCandadoReintentar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_boton_principal"
            android:text="@string/candado_reintentar"
            android:textColor="@color/texto_boton_principal"
            android:textStyle="bold" />

        <!-- Escape: si no puede verificar, que cierre sesión y use el login -->
        <Button
            android:id="@+id/btnCandadoSalir"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_boton_pill"
            android:text="@string/candado_salir"
            android:textColor="@color/acento"
            android:textStyle="bold" />

        <!-- Panel de resultado (avisos de verificación) -->
        <TextView
            android:id="@+id/txtResultadoCandado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_veredicto"
            android:padding="14dp"
            android:textColor="@color/texto_normal"
            android:textIsSelectable="true"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
