<?xml version="1.0" encoding="utf-8"?>
<!-- Sprint 10: perfil del proveedor — SUBE LAS CUENTAS que le deben sus
     clientes y las ve actualizarse en vivo (cuando pagan, cambian solas). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pantalla"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_encabezado"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulo_proveedor"
            android:textColor="@color/blanco"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSubProveedor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/blanco_90"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtEstadoProveedor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:textColor="@color/texto_normal"
        android:textSize="13sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recNotificaciones"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp" />

    <!-- Sprint 10: EL proveedor sube la cuenta (antes era «Enviar factura»). -->
    <Button
        android:id="@+id/btnSubirCuenta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_boton_principal"
        android:text="@string/btn_subir_cuenta"
        android:textColor="@color/texto_boton_principal"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnSalirProveedor"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_boton_pill"
        android:text="@string/proveedor_cerrar_sesion"
        android:textColor="@color/rojo_error"
        android:textStyle="bold" />
</LinearLayout>
<!-- CORTE-S10: el bloque viejo del Sprint 6 se elimina (raíz duplicada) -->

