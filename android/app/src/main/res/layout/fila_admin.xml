<?xml version="1.0" encoding="utf-8"?>
<!-- Fila genérica de la administración: sirve para usuarios y órdenes
     (título = nombre/código, sub = detalle, estado = Activo/abierta…). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_tarjeta_blanca"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/txtFilaTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/primario_medio"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtFilaSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/texto_sobre_tarjeta"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/txtFilaEstado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
