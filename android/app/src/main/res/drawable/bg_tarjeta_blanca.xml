<?xml version="1.0" encoding="utf-8"?>
<!-- 0.7.0-ui · Tarjeta blanca suave (borde redondeado + stroke) para envolver
     bloques como el selector de órdenes y que "floten" sobre el fondo lavanda. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="12dp" />
    <solid android:color="@color/blanco" />
    <stroke
        android:width="1dp"
        android:color="@color/borde_tarjeta" />
</shape>