<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Red: la API corre en Laragon local (HTTP sin cifrar) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- RF-M2: captura con la cámara del dispositivo -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Sprint 6: push FCM al proveedor (Android 13+ lo pide en runtime) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.camera" android:required="true" />

    <!-- HOTFIX 0.4.1: desde Android 11 (API 30) la visibilidad de paquetes está
         filtrada; sin esta declaración <queries> el sistema oculta la app de
         cámara a resolveActivity() aunque exista y el botón "Tomar foto"
         mostraba "sin app de cámara" en móviles reales. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <!-- RF-M3: selector de imágenes del sistema (ACTION_GET_CONTENT) -->
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="image/*" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.CPP">

        <!-- Sprint 5: el LOGIN es la nueva entrada de la app (RF-M1); MainActivity
             deja de ser launcher y AdminActivity aloja el CRUD (RF-B4). -->
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- S10.5: candado obligatorio (huella o contraseña) — se muestra al
             abrir la app con sesión vigente y al entrar por notificación. -->
        <activity
            android:name=".CandadoActivity"
            android:exported="false" />

        <!-- Sprint 4: listado de facturas con badges (RF-M5) -->
        <activity
            android:name=".ListadoActivity"
            android:parentActivityName=".MainActivity" />

        <!-- S10.3: AdminActivity NO regresa. Los roles admin/capturista/revisor
             se unificaron en «cliente»: UNA cuenta (un correo) por empresa
             cliente con todas las funciones y sin CRUD de usuarios. -->

        <!-- Sprint 8: cuentas por pagar del cliente (RF-P1..P3) -->
        <activity
            android:name=".PagosActivity"
            android:parentActivityName=".MainActivity" />

        <!-- Sprint 6: pantalla del proveedor (escucha sus facturas en vivo) -->
        <activity
            android:name=".ProveedorActivity"
            android:parentActivityName=".LoginActivity" />

        <!-- Sprint 6: recibe los push FCM (avisos de factura aunque la app esté cerrada) -->
        <service
            android:name=".PushServicio"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Comparte la foto temporal con la app de cámara (RF-M2) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
